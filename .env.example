# TiDB Cloud / MySQL connection (use environment settings for deployed secrets)
MYSQL_HOST=your-tidb-host
MYSQL_PORT=4000
MYSQL_USER=your-tidb-user
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=your-database

# TiDB is required by default. Set false only for an isolated local test.
REQUIRE_MYSQL=true
SQLITE_PATH=ecosim_local.db
